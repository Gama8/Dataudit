# Copia este archivo como .streamlit/secrets.toml (no lo subas a GitHub).
# El Asistente funciona con Gemini (Google) o con Claude (Anthropic): basta con una de las dos claves.
# Si están las dos, se usa Claude, salvo que DATAUDIT_PROVEEDOR diga otra cosa.

# Gemini, con nivel gratuito: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY = "AIza..."

# Claude, de pago por uso: https://console.anthropic.com
# ANTHROPIC_API_KEY = "sk-ant-..."

# Opcionales:
# DATAUDIT_PROVEEDOR = "gemini"            # gemini | anthropic
# DATAUDIT_MODELO = "gemini-3.8-flash"     # por defecto: gemini-3.8-flash o claude-opus-5-5
# DATAUDIT_ESFUERZO = "high"               # low | medium | high (cuánto razona el modelo)
# DATAUDIT_DB = "datos_app/dataudit.db"    # dónde se guardan tableros y hallazgos
