# Copia este archivo como .streamlit/secrets.toml (no lo subas a GitHub).

# Clave de la API de Anthropic para el Asistente: https://console.anthropic.com
ANTHROPIC_API_KEY = "sk-ant-..."

# Opcionales:
# DATAUDIT_MODELO = "claude-opus-5-5"      # o "claude-sonnet-5-5" (más económico)
# DATAUDIT_ESFUERZO = "high"               # low | medium | high | xhigh | max
# DATAUDIT_DB = "datos_app/dataudit.db"    # dónde se guardan tableros y hallazgos
